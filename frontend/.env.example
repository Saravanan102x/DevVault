# DevVault Frontend Environment Configuration Example
# Copy this file to .env or .env.local to customize for local or production deployment.

# ==============================================================================
# 1. Firebase Spark Plan Configuration (Free Tier - ₹0 Budget)
# ==============================================================================
# Web SDK public project identifiers obtained from Firebase Console > Project Settings.
# NOTE: Firebase Web API keys are project identifiers, NOT private administrative secrets.
# NEVER include service_account.json, private keys, or administrative secrets here!
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run against local Firebase Emulator Suite (Port 8085 / 9099)
VITE_USE_FIREBASE_EMULATOR=false

# Optional: Restrict single-owner login to this specific email address & UID
VITE_DEVVAULT_OWNER_EMAIL=
VITE_DEVVAULT_OWNER_UID=
VITE_FIREBASE_MEASUREMENT_ID=

# ==============================================================================
# 2. Legacy Spring Boot Backend API Base URL (Fallback / Migration Phase)
# ==============================================================================
# Leave empty for local Vite proxy (/api/v1), or specify full URL if using external backend:
VITE_API_BASE_URL=
