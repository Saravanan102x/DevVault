# DevVault Backend Environment Configuration Example
# Copy this file to .env or set these environment variables in your hosting environment.

# Server Port (default: 8080)
PORT=8080

# Allowed CORS origins (comma-separated, without trailing slashes)
# In production, replace with your live frontend domains, e.g.:
# CORS_ALLOWED_ORIGINS=https://devvault.web.app,https://devvault.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Secret Key (enforces real server-side authorization on all mutating endpoints: POST, PUT, DELETE, Backup)
# If left blank, server operates in local development mode without token enforcement.
# In production, set to a strong, high-entropy secret string (e.g. openssl rand -hex 32).
DEVVAULT_ADMIN_KEY=

# Data directory for JSON storage
# DATA_DIRECTORY=/var/data/tech-diary-data

# Backup directory
# BACKUP_DIRECTORY=/var/data/tech-diary-data/backups
